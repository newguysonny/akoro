{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akoro.ng/schemas/documentation-index.schema.json",
  "title": "Akoro Documentation Index",
  "type": "object",
  "required": ["schema_version", "updated", "features"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "updated": { "type": "string", "format": "date" },
    "entrypoint": { "type": "string" },
    "agent_guide": { "type": "string" },
    "capability_registry": { "type": "string" },
    "openapi": { "type": "string" },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "tier", "status", "docs", "capabilities"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
          "status": {
            "type": "string",
            "enum": ["implemented", "beta", "planned", "deprecated", "disabled"]
          },
          "docs": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
