{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akoro.ng/schemas/capability-registry.schema.json",
  "title": "Akoro Capability Registry",
  "type": "object",
  "required": ["schema_version", "platform", "capabilities"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "platform": { "type": "string", "const": "Akoro" },
    "updated": { "type": "string", "format": "date" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "name", "category", "status", "description",
          "documentation", "api_reference", "access",
          "requires_confirmation", "verification_status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["implemented", "beta", "planned", "deprecated", "disabled"]
          },
          "description": { "type": "string", "minLength": 1 },
          "documentation": {
            "type": "array", "minItems": 1, "items": { "type": "string" }
          },
          "api_reference": {
            "type": "array", "items": { "type": "string" }
          },
          "access": {
            "type": "array", "minItems": 1, "items": { "type": "string" }
          },
          "requires_confirmation": { "type": "boolean" },
          "side_effects": {
            "type": "array", "items": { "type": "string" }
          },
          "verification": {
            "type": "array", "items": { "type": "string" }
          },
          "verification_status": {
            "type": "string",
            "enum": ["code-observed", "sandbox-verified", "production-verified", "pending"]
          },
          "last_verified": { "type": "string", "format": "date" },
          "replacement": { "type": "string" },
          "constraints": {
            "type": "array", "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
