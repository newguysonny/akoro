          │                                       │
          ▼                                       ▼
   ┌──────────────────┐               ┌──────────────────────┐
   │  CONTEXT MANAGER │               │  dynamic learner     │
   │  manifest.mjs    │               │  context (tools/DB)  │
   │  setName=op      │               └──────────┬───────────┘
   └────────┬─────────┘                          │
            └─────────────────┬──────────────────┘
                              ▼
                      ┌───────────────┐
                      │  STUDY AGENT  │  reasons, picks the next tool
                      └───────┬───────┘
                              │ structured action (+ bounded intent)
                              ▼
                      ┌───────────────┐
                      │    HARNESS    │  permissions, schema, budget,
                      │   harness.js  │  state, concurrency, idempotency
                      └───────┬───────┘
              reject ◄────────┴───────► execute
                │                          │
                │                          ▼
                │                ┌────────────────────┐
                │                │  EDUCATION ENGINE  │  score, threshold,
                │                │  education-engine  │  transitions, evidence
                │                └──────────┬─────────┘
