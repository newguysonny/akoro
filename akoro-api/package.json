{
  "name": "akoro-api",
  "version": "1.2.0",
  "description": "Akoro Learning Platform — Modular Monolith API",
  "type": "module",
  "scripts": {
    "pharmd:backfill-hash": "node scripts/pharmd-hash-backfill.mjs",
    "postinstall": "patch-package",
    "start": "node app.js",
    "dev": "node --watch app.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch worker.js",
    "db:migrate": "node scripts/apply-migrations.mjs --group=schema",
    "db:seed:demo": "node scripts/apply-migrations.mjs --group=demo",
    "db:deploy": "node scripts/apply-migrations.mjs --group=all",
    "records:backfill-text": "node scripts/backfill-record-text.mjs",
    "test:emails": "node --test modules/auth/emails.render.test.mjs",
    "test:task-scheduling": "node --test modules/adaptive-learning/learner-task-validation.test.mjs modules/adaptive-learning/chat-follow-ups.test.mjs modules/adaptive-learning/learner-time-context.test.mjs",
    "test:agent-context": "node --test modules/agent-tools/conversation-context-validation.test.mjs modules/agent-tool-requests/validation.test.mjs modules/agent-tool-requests/routes.contract.test.mjs",
    "test:agent-chat": "node --test lib/aiModel.responses.contract.test.mjs modules/adaptive-learning/think-loop.contract.test.mjs modules/adaptive-learning/agent-chat-route.contract.test.mjs modules/adaptive-learning/chat-trace.contract.test.mjs modules/adaptive-learning/agent-chat-intent.test.mjs modules/adaptive-learning/agent-tool-request-intent.test.mjs modules/adaptive-learning/websocket-identity.contract.test.mjs",
    "test:adaptive-teaching": "node --test modules/adaptive-learning/teaching-evidence.test.mjs modules/adaptive-learning/teaching-workflow/runner.test.mjs modules/adaptive-learning/document-grounding.contract.test.mjs",
    "smoke:instructor": "node scripts/smoke-instructor.mjs",
    "preflight": "node scripts/preflight-security.mjs",
    "test:structure": "node --test modules/structure.contract.test.mjs",
    "structure:baseline": "node scripts/structure-baseline.mjs",
    "typecheck": "tsc --noEmit",
    "test:client": "node --test modules/client-core.contract.test.mjs modules/client-core.behavior.test.mjs modules/client-auth.behavior.test.mjs modules/client-socket.behavior.test.mjs modules/client-session-user.behavior.test.mjs modules/shared-pages.contract.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@deepgram/sdk": "^3.13.0",
    "@huggingface/hub": "^2.17.5",
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.43.4",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.8.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.3",
    "openai": "^4.47.0",
    "opossum": "^10.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.12.0",
    "quickjs-emscripten": "0.32.0",
    "resend": "^6.14.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "twilio": "^5.2.2",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "overrides": {
    "tar": "^7.5.22",
    "ws": "^8.21.1",
    "brace-expansion": "^5.0.8",
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  }
}
