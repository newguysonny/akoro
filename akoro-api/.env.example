# ─── Instance ─────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=https://app.akoro.io
SHUTDOWN_TIMEOUT=30000

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
DB_POOL_MAX=25
DB_READ_URL=                          # optional read replica

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://default:password@your-redis:6379

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─── Internal secret (worker callback) ───────────────────────
INTERNAL_SECRET=change-this-to-another-random-secret

# ─── Platform commission ──────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=20
PAYOUT_MINIMUM_KOBO=500000

# ─── Cloudflare R2 ────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=akoro-videos
R2_PUBLIC_URL=https://cdn.akoro.io

# ─── Meeting platforms ────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
REDIRECT_URI_ZOOM=https://api.akoro.io/api/meeting/auth/callback/zoom
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI_GOOGLE=https://api.akoro.io/api/meeting/auth/callback/google
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
REDIRECT_URI_TEAMS=https://api.akoro.io/api/meeting/auth/callback/teams

# ─── Email ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@akoro.io

# ─── Twilio SMS / WhatsApp ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
DEFAULT_COUNTRY_CODE=234

# ─── Web Push (VAPID) ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@akoro.io

# ─── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_key
PAYSTACK_PUBLIC_KEY=pk_live_your_key
APP_URL=https://api.akoro.io

# ─── Anthropic (AI agent) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key

# ─── Worker / FFmpeg (VPS only) ──────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_DIR=./temp
WORKER_CONCURRENCY=1
API_BASE_URL=https://api.akoro.io

# ─── Adaptive Learning Module ─────────────────────────────────
# OpenAI — GPT-4o for teaching agents + text-embedding-3-small
OPENAI_API_KEY=sk-your-openai-key

# Deepgram — Nova-2 transcription for teacher audio/video training
DEEPGRAM_API_KEY=your-deepgram-key

# ── JWT RS256 (generate with: node -e "const {generateKeyPairSync}=require('crypto'); ...") ──
JWT_PRIVATE_KEY=     # RSA-2048 private key PEM (\n-escaped as single line)
JWT_PUBLIC_KEY=      # RSA-2048 public  key PEM (\n-escaped as single line)
JWT_ISSUER=https://api.akoro.app
JWT_AUDIENCE=https://akoro.app
