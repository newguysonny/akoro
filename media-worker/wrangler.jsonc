// wrangler.jsonc — Cloudflare Containers deploy for the media worker.
//
// Shape verified against developers.cloudflare.com/containers (Sep 2026):
// a `containers` entry + a Durable Object binding + an `exports` entry
// for the same class. Optional sizing/rollout fields (instance_type and
// friends) are documented in the Wrangler configuration reference
// (developers.cloudflare.com/workers/wrangler/configuration/#containers) —
// omitted here so the first deploy runs on defaults; add them once you
// know your encode sizes.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akoro-media-worker",
  "main": "cf/worker.js",
  "compatibility_date": "2026-10-08",

  // The container image — Wrangler builds and pushes it on deploy
  // (Docker must be running locally). linux/amd64 only.
  "containers": [
    {
      "class_name": "MediaContainer",
      "image": "./Dockerfile",
      // Cap the fleet: encode jobs are heavy, and the container's own
      // MAX_CONCURRENT_JOBS lane guard keeps each instance serialized.
      "max_instances": 2
    }
  ],

  // The Container class IS a Durable Object — this binding is what the
  // edge Worker routes through (env.MEDIA).
  "durable_objects": {
    "bindings": [
      { "name": "MEDIA", "class_name": "MediaContainer" }
    ]
  },

  "exports": {
    "MediaContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
