# ── akoro media-worker ──────────────────────────────────────────────
# The SAME shared secret the API's internal routes use (INTERNAL_SECRET
# on the API side). Requests without a matching x-internal-secret 401.
INTERNAL_SECRET=change-me

# ── R2 (same account/bucket as akoro-api) ───────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=akoro
R2_PUBLIC_URL=https://cdn.example.com

# ── The API, for encode-job callbacks (signed source URLs + status) ─
API_BASE_URL=https://akoro-api.onrender.com

# ── Tuning ──────────────────────────────────────────────────────────
PORT=8080
MAX_CONCURRENT_JOBS=1
ENCODE_VARIANT_CONCURRENCY=2
R2_UPLOAD_CONCURRENCY=8
TEMP_DIR=/tmp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
