{
  // Phase 20 Part B, step 1: the instructor-app checker. Vite already compiles
  // .ts/.tsx, so this only makes `npm run typecheck` real. Files stay .js/.jsx
  // until they are converted, so checkJs stays off (parse gate only).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
