# Required for the default OpenAI-compatible chat client.
OPENAI_API_KEY=

# Optional OpenAI-compatible endpoint, model, and loop controls.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AGENT_TEMPERATURE=0.2
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=45
AGENT_ALLOW_SEARCH=true

# ─── Adaptive agent service ──────────────────────────────────────
# The service accepts calls from akoro-api only. In production this secret must
# match the value the future Node bridge sends as X-Akoro-Agent-Secret.
AGENT_SERVICE_ENVIRONMENT=development
AKORO_AGENT_SERVICE_SECRET=
AGENT_SESSION_TTL_SECONDS=1800

# Reserved for the protected Akoro API persistence adapter. The evaluation
# service remains memory-backed until that adapter is enabled.
AKORO_API_URL=

# ─── Akoro API tool gateway (optional) ───────────────────────────
# Full private gateway base URL, e.g.
# https://api.akoro.app/api/internal/agent-tools/v1. Configure this and the
# outbound-only secret together. The browser must never receive either value.
AKORO_AGENT_TOOLS_URL=
AKORO_AGENT_TOOLS_SECRET=
AGENT_TOOL_TIMEOUT_SECONDS=12
AGENT_TOOL_MAX_CALLS_PER_SESSION=4

# Read-only tools can run when Akoro API grants them in the opaque toolContext.
# Keep side effects disabled until the Akoro API confirmation workflow is wired.
AGENT_ALLOW_SIDE_EFFECTING_TOOLS=false
