# API base URL — the canonical public API domain (Cloudflare-proxied → Render).
# This must be the API's own domain, NOT the learner app domain: cookies are
# scoped to it, so changing it later logs every user out once.
VITE_API_URL=https://api.akoro.name.ng

# Main learner/site URL — its host (a leading www./api./app. is ignored) is used as the wildcard base domain for
# school tenant subdomains (e.g. <slug>.akoro.name.ng). Change the domain here and tenant detection follows.
VITE_LEARNER_URL=https://app.akoro.name.ng

# Landing / app split — src/config/urls.js and src/config/target.js. The fallbacks are the values below; set them anyway.
#   VITE_TARGET=landing   → akoro.name.ng (marketing, no service worker)   VITE_TARGET=app → app.akoro.name.ng   unset → both (dev)
VITE_SITE_URL=https://akoro.name.ng               # the marketing site (Terms, Privacy, blog; where the app forwards marketing paths)
VITE_APP_URL=https://app.akoro.name.ng            # the learner app (where the landing forwards sign-in and product paths)
VITE_INSTRUCTOR_URL=https://instructors.akoro.name.ng

# Optional overrides (only if the above can't be derived):
#   VITE_SITE_BASE_DOMAIN=akoro.name.ng    # wildcard base domain
#   VITE_APP_SUBDOMAINS=www,app,api        # subdomains that are NOT tenant sites

# Per-request deadline in ms for all API calls (default 30000). A stalled
# mobile connection never rejects a fetch on its own — without this the page
# that fired the request shows its loading skeleton forever. Raise it only if
# a deploy is slow enough that healthy requests start hitting it.
#VITE_API_TIMEOUT_MS=30000
