{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "akoro-admin.vercel.app"
        }
      ],
      "destination": "https://admin.akoro.name.ng/$1",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "claude": true
    }
  }
}