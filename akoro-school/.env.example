# API base URL (src/config/urls.js — the fallback is the same, set it anyway).
VITE_API_URL=https://api.akoro.name.ng
VITE_WS_URL=https://api.akoro.name.ng
VITE_SITE_URL=https://akoro.name.ng               # Terms / Privacy links
VITE_LEARNER_URL=https://app.akoro.name.ng        # links to the learner app
# VITE_ADMISSION_BASE_URL=https://apply.akoro.name.ng   # base of the shared admission link (nothing serves it yet)
# This deployment also serves the schools' public sites (the wildcard and custom domains): any host that isn't a portal host
# asks the API for that school's site. Base domain for the wildcard (default: derived from VITE_LEARNER_URL):
# VITE_SITE_BASE_DOMAIN=akoro.name.ng

# This school-app deployment's own URL. Its host renders the admin portal.
# Leave blank and the deployment simply always renders the portal.
VITE_SCHOOL_URL=https://akoro-school.akoro.name.ng

# Optional: extra hosts that should render the portal (comma-separated).
#   VITE_PORTAL_HOSTS=akoro-school.akoro.name.ng,school.akoro.name.ng   # (these two are the default)
