# API base URL (the Railway backend).
VITE_API_URL=https://akoro.name.ng
VITE_WS_URL=https://akoro.name.ng

# This school-app deployment's own URL. Its host renders the admin portal.
# Leave blank and the deployment simply always renders the portal.
VITE_SCHOOL_URL=https://akoro-school.akoro.name.ng

# Optional: extra hosts that should render the portal (comma-separated).
#   VITE_PORTAL_HOSTS=school.akoro.name.ng
